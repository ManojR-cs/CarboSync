# Copy this file to .env. run_backend.ps1 loads it for that server process only.
# Static frontend and local CarbonSync demo origins. Do not use a wildcard.
CARBOSYNC_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CARBOSYNC_SERVE_FRONTEND=1
CARBOSYNC_SERVE_DETECTION_RESULTS=0

# Relative paths are resolved from the repository root by run_backend.ps1.
CARBOSYNC_DATABASE_PATH=carbosync.db
CARBOSYNC_YOLO_MODEL_PATH=backend/models/yolo11n.pt
CARBOSYNC_YOLO_CONFIDENCE=0.15
CARBOSYNC_YOLO_IOU=0.30
CARBOSYNC_YOLO_IMAGE_SIZE=640
CARBOSYNC_YOLO_NMS_MODE=class_aware
CARBOSYNC_YOLO_DEVICE=cpu

# Optional OpenAI-compatible recommendations. Leave the key blank to use fallback.
CARBOSYNC_LLM_PROVIDER=
CARBOSYNC_LLM_API_KEY=
CARBOSYNC_LLM_BASE_URL=https://api.openai.com/v1
CARBOSYNC_LLM_MODEL=gpt-4o-mini
